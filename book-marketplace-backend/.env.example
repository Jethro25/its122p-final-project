# ── Database (MySQL local or TiDB Cloud) ─────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=book_marketplace
DB_USER=root
DB_PASS=
DB_SSL=false

# ── Transactional Email (Resend API) ─────────────────────────────────
# Leave RESEND_API_KEY blank to enable local dev logging mode.
# In dev mode verification and reset links are logged to /tmp/librowse_mail.log
# and also returned in the API response as dev_preview_link so you can click through.
RESEND_API_KEY=
MAIL_FROM=Librowse Book Exchange <onboarding@resend.dev>
APP_URL=http://127.0.0.1:8000

# ── PayPal Payments ───────────────────────────────────────────────────
# PAYPAL_MODE:
#   simulated  — no PayPal account needed; runs fully offline (default)
#   sandbox    — real PayPal sandbox with test money
#
# Get sandbox credentials at: https://developer.paypal.com
#   App & Credentials → Create App → copy Client ID and Secret
#
PAYPAL_MODE=simulated
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=PHP

# ── Debug ─────────────────────────────────────────────────────────────
# Set to 1 to include SQL/exception details in API error responses.
# NEVER enable in production.
APP_DEBUG=0
